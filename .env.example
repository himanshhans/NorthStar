# --- Frontend (safe to ship to browser) ---
# Clerk publishable key (Clerk Dashboard > API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Supabase project URL + anon (public) key (Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx

# --- Server only (NEVER prefix with VITE_, never commit real values) ---
# These live as Supabase Edge Function secrets, not in this frontend bundle.
# Set via: supabase secrets set OPENROUTER_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...                         # from https://openrouter.ai/keys
# OPENROUTER_MODEL=moonshotai/kimi-k2.6:free          # optional primary (verify live at openrouter.ai/models?max_price=0)
# OPENROUTER_MODEL_FALLBACK=google/gemma-4-31b-it:free # optional
# CLERK_ISSUER=https://<your-app>.clerk.accounts.dev   # used to verify Clerk JWTs in edge functions
